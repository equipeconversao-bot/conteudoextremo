{
  "framework": "vite",
  "buildCommand": "npm --prefix content-hub run build",
  "outputDirectory": "content-hub/dist",
  "installCommand": "npm --prefix content-hub install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/content-hub/api" },
    { "source": "/(.*)", "destination": "/content-hub/index.html" }
  ]
}
